// lib/chat/embedding-cache.ts
import { supabase } from '@/lib/jarvis';
import { generateEmbedding } from '@/lib/jarvis';

function hashCode(str: string): string {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash).toString(16);
}

export async function getCachedEmbedding(text: string): Promise<number[] | null> {
  const hash = hashCode(text);
  const cacheKey = `embedding_${hash}`;
  
  // 1. Tenta cache no banco
  const {  data } = await supabase
    .from('config')
    .select('value')
    .eq('key', cacheKey)
    .single();
  
  if (data?.value) {
    try {
      return JSON.parse(data.value);
    } catch {
      // Cache corrompido, continua para gerar novo
    }
  }
  
  // 2. Gera novo embedding
  const embedding = await generateEmbedding(text);
  
  // 3. Salva no cache
  if (embedding) {
    await supabase.from('config').upsert({
      key: cacheKey,
      value: JSON.stringify(embedding),
      updated_at: new Date().toISOString()
    });
  }
  
  return embedding;
}